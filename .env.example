# ===================== Asosiy =====================
DATABASE_URL=postgres://user:password@localhost:5432/aikadr
# Kamida 32 ta tasodifiy belgi:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=
PUBLIC_URL=https://sizning-domen.uz
PORT=5000
STORAGE_DIR=./storage

# ===================== AI (fal.ai) =====================
# https://fal.ai/dashboard/keys — kalit bo'lmasa sayt "sinov" (mock) rejimida ishlaydi.
# Production'da kalitsiz mijozlar generatsiya qila olmaydi (soxta natija uchun pul olinmasin)
FAL_KEY=
# Faqat demo uchun: production'da ham sinov rejimida generatsiyaga ruxsat (pul olinadi!) — odatda bo'sh qoldiring
ALLOW_MOCK_AI=
# Admin paneldagi "AI tahlil" (videoni ko'rib personaj va promptlarni taklif qiladi)
# https://openrouter.ai/keys — bo'lmasa namunaviy (sinov) tahlil qaytadi
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemini-3.8-flash
# Bir vaqtda nechta generatsiya bajariladi
WORKER_CONCURRENCY=4

# ===================== Payme =====================
# business.payme.uz → kassa → "Merchant ID" va "Kalit" (test/production)
PAYME_MERCHANT_ID=
PAYME_KEY=
# true = checkout.test.paycom.uz (sandbox sinovi paytida). Production'da false (sukut bo'yicha ham false)
PAYME_TEST_MODE=false
# Fiskal chek uchun MXIK (IKPU) va o'lchov birligi kodi (tasnif.soliq.uz)
PAYME_IKPU_CODE=
PAYME_PACKAGE_CODE=
PAYME_VAT_PERCENT=0

# ===================== Click =====================
# merchant.click.uz → Service ID, Merchant ID, Secret key
CLICK_SERVICE_ID=
CLICK_MERCHANT_ID=
CLICK_SECRET_KEY=

# ===================== Sinov =====================
# Production'da ALBATTA false bo'lsin — aks holda bepul "to'lov" mumkin
PAYMENTS_TEST_MODE=false
